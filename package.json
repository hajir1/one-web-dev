{
  "name": "onewebdev-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --import ./src/testSetup.ts --test 'src/**/*.test.ts'",
    "icons": "node generate-icons.mjs",
    "gen:demo": "tsx src/tools/genDemoTemplates.ts",
    "gen:code": "tsx src/tools/genCodeTemplates.ts",
    "gen:thumbs": "tsx src/tools/genThumbs.ts",
    "locales": "node scripts/split-locales.mjs",
    "predev": "node scripts/split-locales.mjs",
    "prebuild": "node scripts/split-locales.mjs",
    "pretest": "node scripts/split-locales.mjs",
    "prebuild:demo": "node scripts/split-locales.mjs",
    "templates:gen": "node scripts/split-locales.mjs && tsx --import ./src/testSetup.ts scripts/templates-ci/gen-sites.ts .template-sites",
    "templates:check": "node scripts/templates-ci/check.mjs .template-sites",
    "notices": "node scripts/third-party-notices.mjs",
    "templates:baseline": "node scripts/templates-ci/check.mjs .template-sites --update-baseline"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/qoi": "^1.1.0",
    "@jsquash/webp": "^1.5.0",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@mediabunny/flac-encoder": "^1.61.6",
    "@mediabunny/mp3-encoder": "^1.61.6",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.90.0",
    "@vercel/analytics": "^1.6.1",
    "exceljs": "^4.4.0",
    "gifenc": "^1.0.3",
    "i18next": "^25.0.0",
    "imagetracerjs": "^1.2.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.540.0",
    "mediabunny": "^1.61.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.394",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "react-router": "^7.6.0",
    "svgo": "4.0.0",
    "utif2": "^4.1.0",
    "wasm-media-encoders": "^0.7.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "uuid": "^11.1.1"
  }
}
