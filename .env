# Salin ke .env di root proyek frontend (sejajar package.json).
# URL backend NestJS. Default bila tidak diisi: http://localhost:3000
# VITE_API_BASE_URL=http://localhost:3000
# Isi "off" untuk menjalankan frontend tanpa backend = MODE DEMO (v12): tanpa akun,
# kredit, dan paket; semua template katalog bawaan frontend (semua gratis); semua elemen gratis;
# hanya alat yang berjalan di browser. Batas tetap 2 website & 10 desain halaman.
VITE_API_BASE_URL=off
# Cara cepat build demo: `npm run build:demo` (memakai .env.demo). Panduan deploy: DEPLOY-DEMO.md
