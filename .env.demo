# v13: dipakai `npm run build:demo` (vite --mode demo). Menimpa nilai di .env.
# MODE DEMO: tanpa backend, tanpa akun/kredit/paket; semua template katalog bawaan
# frontend (semua gratis); semua elemen gratis; hanya alat yang berjalan di browser.
VITE_API_BASE_URL=off
# Awalan path situs. "/" untuk Vercel / domain sendiri / nama.github.io.
# GitHub Pages proyek (https://nama.github.io/repo/): isi /repo/ (workflow deploy-pages.yml mengisinya otomatis).
# VITE_BASE_PATH=/
